# ── $SHELL Miner Configuration ────────────────────────────────────────────────
# Run `npx @openshell-cc/miner-cli setup` to configure interactively
# 挖矿默认只需要 SHELL_API_KEY；LLM_API_KEY 可选，用于高效模式

# Oracle endpoint (production)
ORACLE_URL=https://oracle.openshell.cc

# ── Authentication ────────────────────────────────────────────────────────────

# $SHELL API Key (推荐) — 在 https://openshell.cc/dashboard 注册获取
SHELL_API_KEY=

# Solana Wallet (可选，已有钱包才需要)
# WALLET_PRIVATE_KEY=

# ── LLM 高效模式（可选）────────────────────────────────────────────────────────
# 默认为免费模式（平台 AI 生成 payload，无需 API Key，积分 ×0.2）
# 配置 LLM_API_KEY 自动切换到高效模式（积分 ×1.0，无次数限制）
# API Key 仅在本地运行，不上传平台，完全安全

# 内置提供商:
#   anthropic  → console.anthropic.com     (默认: claude-haiku-4-5)
#   openai     → platform.openai.com       (默认: gpt-4o-mini)
#   deepseek   → platform.deepseek.com     (默认: deepseek-chat，最便宜)
#   gemini     → aistudio.google.com       (默认: gemini-2.5-flash)
#   grok       → console.x.ai             (默认: grok-3-mini-fast)
#   moonshot   → platform.moonshot.cn      (默认: moonshot-v1-8k)
#   bailian    → dashscope.aliyuncs.com    (默认: qwen-plus)

# LLM_PROVIDER=deepseek
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

# 自定义 OpenAI 兼容 API（Ollama, vLLM, Together, Fireworks 等）:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3
# LLM_API_KEY=ollama

# ── Mining Configuration ──────────────────────────────────────────────────────

# 执行模式:
#   sandbox_only  — 默认推荐：平台 AI 生成 payload，零第三方 API Key
#   auto          — 自动（有本地模型时同时接受 sandbox + local_compute 任务）
EXECUTION_MODE=sandbox_only

# 轮询间隔自动调整，无需手动配置:
#   免费模式: 20-40 分钟随机间隔
#   高效模式: 5-10 分钟随机间隔
# POLLING_INTERVAL_MS=  (留空使用自动值)
